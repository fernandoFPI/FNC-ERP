# ============================================================
# FNC ERP — Environment Variables
# Copy this file to .env and fill in all values before running
# ============================================================

# --- Database ---
# Dev DB (Docker Compose postgres service)
DATABASE_URL=postgresql://fnc_app:dev_password_change_in_prod@localhost:5432/fnc_erp_dev

# Test DB (docker-compose.test.yml postgres_test service — port 5433)
DATABASE_TEST_URL=postgresql://fnc_app:test_password@localhost:5433/fnc_erp_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=                          # min 32 chars
JWT_REFRESH_SECRET=                  # min 32 chars — MUST differ from JWT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# Generate with: openssl rand -hex 32  (produces 64 hex chars = 32 bytes for AES-256)
ENCRYPTION_KEY=                      # exactly 64 hex characters

# --- Service Ports ---
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
FINANCE_SERVICE_PORT=3002
PROCUREMENT_SERVICE_PORT=3003
HR_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
PROJECTS_SERVICE_PORT=3006
MANUFACTURING_SERVICE_PORT=3007

# --- Runtime ---
NODE_ENV=development                  # development | test | production

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Internal service URLs (used by gateway) ---
AUTH_SERVICE_URL=http://localhost:3001

# --- Backblaze B2 ---
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=fnc-erp-dev
B2_BUCKET_PUBLIC_URL=                 # optional CDN URL

# --- PDF Generation (Patch C) ---
# PUPPETEER_EXECUTABLE_PATH=          # leave empty to use bundled Chromium
PDF_STORAGE_FOLDER=generated-pdfs

# --- Email / SMTP (Patch C) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                     # true for port 465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=FNC ERP
EMAIL_FROM_ADDRESS=noreply@fnc-group.com
# EMAIL_REPLY_TO=support@fnc-group.com

# --- Invoice QR Verification ---
# Public URL of the web app — used by the worker to embed verify links in invoice QR codes
# Dev: http://localhost:5173 | Prod: https://erp.fncgroup.com
APP_BASE_URL=

# --- FX Rate Sync (Patch E) ---
# Primary source: https://www.exchangerate-api.com (free: 1500 req/month)
EXCHANGE_RATE_API_KEY=
# Fallback source: https://openexchangerates.org (free: 1000 req/month)
OPEN_EXCHANGE_RATES_APP_ID=
