# ============================================================
# FNC ERP — Environment Variables
# Copy this file to .env and fill in all values before running
# ============================================================

# --- Database ---
# Dev DB (Docker Compose postgres service)
DATABASE_URL=postgresql://fnc_app:dev_password_change_in_prod@localhost:5432/fnc_erp_dev

# Test DB (docker-compose.test.yml postgres_test service — port 5433)
DATABASE_TEST_URL=postgresql://fnc_app:test_password@localhost:5433/fnc_erp_test

# --- Redis ---
# Password must match REDIS_PASSWORD below (used by docker-compose.yml's --requirepass)
REDIS_PASSWORD=dev_redis_password_change_in_prod
REDIS_URL=redis://:dev_redis_password_change_in_prod@localhost:6379

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=                          # min 32 chars
JWT_REFRESH_SECRET=                  # min 32 chars — MUST differ from JWT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Internal service-to-service auth ---
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=                       # min 32 chars

# --- Encryption ---
# Generate with: openssl rand -hex 32  (produces 64 hex chars = 32 bytes for AES-256)
ENCRYPTION_KEY=                      # exactly 64 hex characters

# --- Service Ports ---
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
FINANCE_SERVICE_PORT=3002
PROCUREMENT_SERVICE_PORT=3003
HR_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
PROJECTS_SERVICE_PORT=3006
MANUFACTURING_SERVICE_PORT=3007
INTERCO_SERVICE_PORT=3008
NOTIFICATIONS_SERVICE_PORT=3009
RENTAL_SERVICE_PORT=3010
REPORTING_SERVICE_PORT=3011

# --- Runtime ---
NODE_ENV=development                  # development | test | production

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend URL (used for password-reset links etc.) ---
FRONTEND_URL=http://localhost:5173

# --- Internal service URLs (used by the gateway to reach each service) ---
# GATEWAY_URL is the reverse direction — other services call it to publish
# live-update events into the gateway's GraphQL subscriptions (see
# services/gateway/src/routes/internal-events.ts).
GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
FINANCE_SERVICE_URL=http://localhost:3002
PROCUREMENT_SERVICE_URL=http://localhost:3003
HR_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3005
PROJECTS_SERVICE_URL=http://localhost:3006
MANUFACTURING_SERVICE_URL=http://localhost:3007
INTERCO_SERVICE_URL=http://localhost:3008
NOTIFICATIONS_SERVICE_URL=http://localhost:3009
RENTAL_SERVICE_URL=http://localhost:3010
REPORTING_SERVICE_URL=http://localhost:3011

# --- Backblaze B2 ---
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=fnc-erp-dev
B2_BUCKET_PUBLIC_URL=                 # optional CDN URL
# Separate bucket for DB/Redis backups — not read by the app itself, only by
# scripts/backup-db.sh and scripts/backup-redis.sh
B2_BACKUP_BUCKET=

# --- PDF Generation (Patch C) ---
# PUPPETEER_EXECUTABLE_PATH=          # leave empty to use bundled Chromium
PDF_STORAGE_FOLDER=generated-pdfs

# --- Email (Microsoft Graph API — app-only client-credentials auth) ---
# Requires an Azure AD app registration with an application (not delegated)
# Mail.Send permission, admin-consented. See PROJECT_STATUS docs for the
# step-by-step Azure Portal setup.
MSGRAPH_TENANT_ID=                    # Directory (tenant) ID
MSGRAPH_CLIENT_ID=                    # Application (client) ID
MSGRAPH_CLIENT_SECRET=                # Client secret VALUE (not the secret ID)
MSGRAPH_SENDER_ADDRESS=               # Mailbox Graph sends as, e.g. noreply@fnc-group.com
EMAIL_FROM_NAME=FNC ERP
EMAIL_FROM_ADDRESS=noreply@fnc-group.com
# EMAIL_REPLY_TO=support@fnc-group.com

# --- Invoice QR Verification ---
# Public URL of the web app — used by the worker to embed verify links in invoice QR codes
# Dev: http://localhost:5173 | Prod: https://erp.fncgroup.com
APP_BASE_URL=

# --- FX Rate Sync (Patch E) ---
# Primary source: https://www.exchangerate-api.com (free: 1500 req/month)
EXCHANGE_RATE_API_KEY=
# Fallback source: https://openexchangerates.org (free: 1000 req/month)
OPEN_EXCHANGE_RATES_APP_ID=
