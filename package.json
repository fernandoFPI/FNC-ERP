{
  "name": "fnc-erp",
  "version": "1.1.0",
  "private": true,
  "description": "FNC Group ERP System — monorepo root",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=30",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "migrate": "pnpm --filter @fnc-erp/db migrate",
    "migrate:test": "NODE_ENV=test pnpm --filter @fnc-erp/db migrate",
    "seed": "pnpm --filter @fnc-erp/db seed",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1058.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.1.0",
    "redis": "^6.0.0",
    "tsx": "^4.22.4"
  }
}
