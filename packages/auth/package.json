{
  "name": "@fnc-erp/auth",
  "version": "1.1.0",
  "private": true,
  "description": "Shared auth utilities: JWT, bcrypt, middleware, encryption, MFA",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fnc-erp/config": "workspace:*",
    "@fnc-erp/db": "workspace:*",
    "@fnc-erp/permissions": "workspace:*",
    "@fnc-erp/types": "workspace:*",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/express": "^4.17.21",
    "typescript": "^5.4.5"
  }
}
