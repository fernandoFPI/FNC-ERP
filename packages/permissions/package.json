  },
  "dependencies": {
    "@fnc-erp/config": "workspace:*",
    "@fnc-erp/db": "workspace:*",
    "@fnc-erp/types": "workspace:*",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.4.5"
  }
}
