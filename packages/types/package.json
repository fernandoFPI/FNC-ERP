{
  "name": "@fnc-erp/types",
  "version": "1.1.0",
  "private": true,
  "description": "Shared TypeScript interfaces for all FNC ERP domain entities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
