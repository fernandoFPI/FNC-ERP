    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fnc-erp/config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
