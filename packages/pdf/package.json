{
  "name": "@fnc-erp/pdf",
  "version": "1.1.0",
  "private": true,
  "description": "Puppeteer PDF engine and HTML templates for FNC ERP documents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./templates/payslip": {
      "source": "./src/templates/payslip.ts",
      "import": "./dist/templates/payslip.js",
      "types": "./dist/templates/payslip.d.ts"
    },
    "./templates/invoice": {
      "source": "./src/templates/invoice.ts",
      "import": "./dist/templates/invoice.js",
      "types": "./dist/templates/invoice.d.ts"
    },
    "./templates/purchase-order": {
      "source": "./src/templates/purchase-order.ts",
      "import": "./dist/templates/purchase-order.js",
      "types": "./dist/templates/purchase-order.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fnc-erp/config": "workspace:*",
    "@fnc-erp/logger": "workspace:*",
    "puppeteer": "^22.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  }
}
