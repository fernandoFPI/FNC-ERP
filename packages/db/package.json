{
  "name": "@fnc-erp/db",
  "version": "1.1.0",
  "private": true,
  "description": "Shared PostgreSQL client, migrations, RLS helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "migrate": "tsx migrations/run-migrations.ts",
    "seed": "tsx seeds/run-seeds.ts",
    "seed:permissions": "tsx seeds/seed-permissions.ts",
    "init-db": "psql postgresql://postgres:admin@localhost:5432/postgres -f scripts/init-db.sql"
  },
  "dependencies": {
    "@fnc-erp/config": "workspace:*",
    "bcrypt": "^5.1.1",
    "pg": "^8.11.5",
    "redis": "^6.0.0"
  },
  "peerDependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "express": "^4.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
